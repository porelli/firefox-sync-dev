{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["syncDomain"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "syncstorageTag": {
          "type": "string"
        },
        "initTag": {
          "type": "string"
        },
        "adminTag": {
          "type": "string"
        }
      }
    },
    "syncDomain": {
      "type": "string",
      "pattern": "^https?://",
      "minLength": 1
    },
    "maxUsers": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(fixed:|initial:)?([0-9]+|unlimited)$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "fxa": {
      "type": "object",
      "properties": {
        "oauthServerUrl": {
          "type": "string"
        },
        "emailDomain": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["mariadb", "mysql", "postgres"]
        },
        "bundled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": ["mariadb", "mysql", "postgres"],
          "properties": {
            "mariadb": {
              "type": "string",
              "minLength": 1
            },
            "mysql": {
              "type": "string",
              "minLength": 1
            },
            "postgres": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "postgresSyncUser": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "maxLength": 32
        },
        "admin": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "user": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "syncUser": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "$comment": "a number, or the same quoted (checked for 1-65535 at render time), or empty for the backend's default port",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "pattern": "^([0-9]{1,5})?$"
                }
              ]
            },
            "storageHost": {
              "type": "string"
            },
            "storagePort": {
              "$comment": "a number, or the same quoted (checked for 1-65535 at render time), or empty for the backend's default port",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "pattern": "^([0-9]{1,5})?$"
                }
              ]
            },
            "tokenserverDatabase": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "tokenserverUser": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "storageDatabase": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "storageUser": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "postgresDatabase": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "postgresUser": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "tlsVerify": {
              "type": "boolean"
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "existingSecret": {
      "type": "string"
    },
    "syncstorage": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer"
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "password": {
          "type": "string"
        },
        "alertEmail": {
          "type": "string"
        },
        "smtp": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": ["integer", "string"]
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "secure": {
              "type": ["string", "boolean"]
            },
            "sender": {
              "type": "string"
            }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "redirectUrl": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "groupsClaim": {
              "type": "string"
            },
            "trustUnverifiedEmail": {
              "type": ["string", "boolean"]
            }
          }
        },
        "trustedHeader": {
          "type": "object",
          "properties": {
            "header": {
              "type": "string"
            },
            "groupsHeader": {
              "type": "string"
            },
            "trustedProxies": {
              "type": "string"
            }
          }
        },
        "allowed": {
          "type": "object",
          "properties": {
            "users": {
              "type": "string"
            },
            "groups": {
              "type": "string"
            }
          }
        },
        "notify": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "metricsToken": {
          "type": "string"
        },
        "tz": {
          "type": "string"
        },
        "publicCheck": {
          "type": ["string", "boolean"]
        },
        "updateCheck": {
          "type": ["string", "boolean"]
        },
        "staleDays": {
          "type": "integer",
          "minimum": 0
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "auditRetentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "purge": {
          "type": ["string", "integer"]
        },
        "errorRatePercent": {
          "type": "integer",
          "minimum": 0
        },
        "errorRateMinErrors": {
          "type": "integer",
          "minimum": 0
        },
        "dbGrowthMb": {
          "type": "integer",
          "minimum": 0
        },
        "dbGrowthFactor": {
          "type": "integer",
          "minimum": 0
        },
        "deleteUnconfirmedDays": {
          "type": ["string", "integer"]
        },
        "signupBurst": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretName": {
                  "type": "string"
                }
              }
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "keep": {
          "type": "integer",
          "minimum": 1
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
