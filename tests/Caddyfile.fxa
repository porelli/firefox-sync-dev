# Test reverse proxy for docker-compose.fxa.yml: HTTPS with Caddy's internal CA
{
	skip_install_trust
	# certificates of the internal CA for 30 days, not 12 hours: the admin UI warns
	# under 14 days (tests/test_fxa_admin.py), the intermediate must outlive them
	cert_issuer internal {
		lifetime 30d
	}
	pki {
		ca local {
			intermediate_lifetime 60d
		}
	}
	# like nginx with $proxy_add_x_forwarded_for: keep the X-Forwarded-For sent by the
	# clients (all on the private test network) and append theirs
	servers {
		trusted_proxies static private_ranges
	}
}

accounts.fxa.test {
	reverse_proxy fxa-content:3030
}

api.fxa.test {
	# the sign-up gate of the admin UI
	@create {
		method POST
		path /v1/account/create
	}
	reverse_proxy @create ffs-admin:8081
	reverse_proxy fxa-auth:9000
}

admin.fxa.test {
	reverse_proxy ffs-admin:8080
}

profile.fxa.test {
	handle_path /img/* {
		reverse_proxy fxa-profile-static:1112
	}
	reverse_proxy fxa-profile:1111
}

pairing.fxa.test {
	reverse_proxy fxa-pairing:8000
}

sync.fxa.test {
	reverse_proxy syncstorage:8000
}
