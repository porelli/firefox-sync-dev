[Unit]
Description=Firefox sync server
Requires=docker.service
After=docker.service

[Service]
# docker compose reads COMPOSE_FILE and COMPOSE_PROJECT_NAME from .env in WorkingDirectory
# (prepare_environment.sh writes them: the files of compose/, with the self-hosted accounts
# theirs, which are then started and stopped with the rest)
Restart=always
User=<DOCKER_USER>
Group=docker
WorkingDirectory=<COMPOSE_DIR>
# Shutdown containers (if running) when unit is started
ExecStartPre=/usr/bin/docker compose down
# Start containers when unit is started
ExecStart=/usr/bin/docker compose up
# Stop containers when unit is stopped
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target