[Unit]
Description=Firefox Sync - Mozilla accounts - Accounts web pages
After=firefox-sync-network.service firefox-sync-fxa-auth.service firefox-sync-fxa-profile.service
Requires=firefox-sync-fxa-auth.service
# its pages read the names and avatars from the profile server (compose waits until it is
# healthy; here, as for fxa-auth, it is started first, see README.md)
Wants=firefox-sync-fxa-profile.service

[Container]
Image=%FXA_IMAGE%:%FXA_VERSION%
ContainerName=firefox-sync-fxa-content
Network=firefox-sync-network.network
PodmanArgs=--network-alias=fxa-content
# Mozilla publishes amd64 images only (emulated elsewhere), see FXA.md for arm64 images
PodmanArgs=--arch=%FXA_ARCH%
Environment="NODE_ENV=production"
Environment="CONFIG_FILES=/tmp/content-server.json"
Environment="CONTENT_SESSION_SECRET=%FXA_CONTENT_SESSION_SECRET%"
Environment="PUBLIC_URL=%FXA_CONTENT_URL%"
Environment="FXA_URL=%FXA_AUTH_URL%"
Environment="FXA_OAUTH_URL=%FXA_AUTH_URL%"
Environment="FXA_PROFILE_URL=%FXA_PROFILE_URL%"
Environment="FXA_PROFILE_IMAGES_URL=%FXA_PROFILE_URL%/img"
Environment="SYNC_TOKENSERVER_URL=%SYNCSTORAGE_DOMAIN%"
# as in fxa-auth: the admin UI never skips the sign-in code (Mozilla's default + the admin UI)
Environment="SERVICES_WITH_EMAIL_VERIFICATION=32aaeb6f1c21316a,%ADMIN_FXA_CLIENT_ID%"
Environment="FLOW_ID_KEY=%FXA_FLOW_ID_KEY%"
Environment="FEATURE_FLAGS_REDIS_HOST=fxa-redis"
Environment="REDIS_HOST=fxa-redis"
Environment="GEODB_ENABLED=false"
Volume=%SCRIPT_DIR%/config/fxa:/fxa-config:ro,z
PublishPort=%FXA_CONTENT_EXPORT_PORT%:3030
HealthCmd=node -e "fetch('http://localhost:3030/__heartbeat__').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
HealthInterval=15s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=300s
Exec=sh -c 'cd /fxa/packages/fxa-content-server && node /fxa-config/content-server.js /tmp/content-server.json && exec node server/bin/fxa-content-server.js'

AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target default.target
