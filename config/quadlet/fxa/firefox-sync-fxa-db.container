[Unit]
Description=Firefox Sync - Mozilla accounts - Database
After=firefox-sync-network.service

[Container]
Image=docker.io/library/mysql:8.4
ContainerName=firefox-sync-fxa-db
Network=firefox-sync-network.network
PodmanArgs=--network-alias=fxa-db
Environment="MYSQL_ROOT_PASSWORD=%FXA_MYSQL_PASSWORD%"
Volume=firefox-sync-fxa-db.volume:/var/lib/mysql
HealthCmd=mysqladmin ping -h 127.0.0.1 --protocol=tcp -uroot -p%FXA_MYSQL_PASSWORD% --silent
HealthInterval=15s
HealthRetries=10
Exec=mysqld --mysql-native-password=ON --authentication-policy=mysql_native_password --event-scheduler=ON

AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target default.target
