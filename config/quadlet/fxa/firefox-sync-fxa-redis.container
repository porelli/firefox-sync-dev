[Unit]
Description=Firefox Sync - Mozilla accounts - Redis
After=firefox-sync-network.service

[Container]
Image=docker.io/library/redis:alpine
ContainerName=firefox-sync-fxa-redis
Network=firefox-sync-network.network
PodmanArgs=--network-alias=fxa-redis
HealthCmd=redis-cli ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target default.target
