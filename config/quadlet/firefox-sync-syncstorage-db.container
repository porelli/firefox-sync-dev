[Unit]
Description=Firefox Sync - Syncstorage Database
After=firefox-sync-network.service

[Container]
Image=docker.io/library/mariadb:lts
ContainerName=firefox-sync-syncstorage-db
Network=firefox-sync-network.network
Volume=firefox-sync-syncstorage-db.volume:/var/lib/mysql
Volume=%SCRIPT_DIR%/config/database/admin-user.sh:/ffs-db/admin-user.sh:ro,z

Environment=MARIADB_RANDOM_ROOT_PASSWORD=true
Environment=MARIADB_DATABASE=%MARIADB_SYNCSTORAGE_DATABASE%
Environment=MARIADB_USER=%MARIADB_SYNCSTORAGE_USER%
Environment=MARIADB_PASSWORD=%MARIADB_SYNCSTORAGE_PASSWORD%
Environment=MARIADB_AUTO_UPGRADE=true
# the admin UI's reader of the Sync data, created by config/database/admin-user.sh:
# SELECT and DELETE here (sizes, purges, resets)
Environment=ADMIN_DB_ROLE=storage
Environment=ADMIN_DB_SYNC_USER=%ADMIN_DB_SYNC_USER%
Environment=ADMIN_DB_PASSWORD=%ADMIN_DB_PASSWORD%

Exec=sh /ffs-db/admin-user.sh mariadbd --explicit_defaults_for_timestamp

HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target