# Backups of the tokenserver and storage databases (ADMIN.md#backups): started by
# firefox-sync-backup.timer, off until you enable it:
#   systemctl --user enable --now firefox-sync-backup.timer
# One now: systemctl --user start firefox-sync-backup.service
[Unit]
Description=Firefox Sync - Backup of the databases
After=firefox-sync-network.service firefox-sync-tokenserver-db.service firefox-sync-syncstorage-db.service

[Container]
# SYNC_DB=mysql: MySQL's own client and mysqldump (the MariaDB client refuses MySQL's
# self-signed certificate)
Image=docker.io/library/mysql:8.4
ContainerName=firefox-sync-backup
Network=firefox-sync-network.network
Volume=firefox-sync-backups.volume:/backups
Volume=%SCRIPT_DIR%/config/backup:/ffs-backup:ro,z
Environment="BACKUP_SCOPE=sync"
Environment="BACKUP_KEEP=%BACKUP_KEEP%"
Environment="MARIADB_TLS_VERIFY=%SYNC_DB_TLS_VERIFY%"
Environment="TOKENSERVER_DB_TYPE=mysql"
Environment="TOKENSERVER_DB_HOST=%SYNC_TOKENSERVER_DB_HOST%"
Environment="TOKENSERVER_DB_PORT=%SYNC_TOKENSERVER_DB_PORT%"
Environment="TOKENSERVER_DB_NAME=%SYNC_TOKENSERVER_DB_NAME%"
Environment="TOKENSERVER_DB_USER=%SYNC_TOKENSERVER_DB_USER%"
Environment="TOKENSERVER_DB_PASSWORD=%SYNC_TOKENSERVER_DB_PASSWORD%"
Environment="STORAGE_DB_HOST=%SYNC_STORAGE_DB_HOST%"
Environment="STORAGE_DB_PORT=%SYNC_STORAGE_DB_PORT%"
Environment="STORAGE_DB_NAME=%SYNC_STORAGE_DB_NAME%"
Environment="STORAGE_DB_USER=%SYNC_STORAGE_DB_USER%"
Environment="STORAGE_DB_PASSWORD=%SYNC_STORAGE_DB_PASSWORD%"
# the admin UI's database: dumped too, and where the runs are recorded
Environment="ADMIN_DB_USER=%ADMIN_DB_USER%"
Environment="ADMIN_DB_PASSWORD=%ADMIN_DB_PASSWORD%"
Environment="ADMIN_DB_NAME=%ADMIN_DB_NAME%"
Exec=sh /ffs-backup/backup.sh now

[Service]
Type=oneshot
