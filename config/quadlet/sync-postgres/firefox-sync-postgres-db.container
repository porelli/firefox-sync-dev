# Installed with the Sync server on PostgreSQL (docs/databases.md#postgresql), instead of the two
# MariaDB units: one database for the tokenserver and the storage, as compose/sync-postgres.yml's postgres_db.
[Unit]
Description=Firefox Sync - PostgreSQL Database
After=firefox-sync-network.service

[Container]
# SYNC_POSTGRES_IMAGE of .env: the major of the install (prepare_environment.sh writes
# postgres:<the major of postgres:latest> for new installs). An image of another major than
# the data's does not start: db/postgres/keep-major.sh stops it and says what to set
# (docs/upgrading.md#postgresql); AutoUpdate=registry follows the pinned major's minors
Image=%SYNC_POSTGRES_IMAGE%
ContainerName=firefox-sync-postgres-db
Network=firefox-sync-network.network
Volume=firefox-sync-postgres-db.volume:/var/lib/postgresql
Volume=%SCRIPT_DIR%/db/postgres/keep-major.sh:/ffs-db/keep-major.sh:ro,z

# SYNC_POSTGRES_USER: the container's superuser (the init containers and the backups' owner
# checks); the Sync server has a role of its own, SYNC_POSTGRES_APP_USER
Environment=POSTGRES_DB=%SYNC_POSTGRES_NAME%
Environment=POSTGRES_USER=%SYNC_POSTGRES_USER%
Environment=POSTGRES_PASSWORD=%SYNC_POSTGRES_PASSWORD%
Environment=FFS_POSTGRES_IMAGE=%SYNC_POSTGRES_IMAGE%
# for the restore of docs/backups.md#restore-with-quadlets, which loads each dump as the role
# that owns it: the Sync server's role (SYNC_POSTGRES_USER without SYNC_POSTGRES_APP_USER),
# and the admin UI's (the init container creates both)
Environment=FFS_SYNC_USER=%SYNC_POSTGRES_CONNECT_USER%
Environment=FFS_SYNC_PASSWORD=%SYNC_POSTGRES_CONNECT_PASSWORD%
Environment=ADMIN_DB_USER=%ADMIN_DB_USER%
Environment=ADMIN_DB_PASSWORD=%ADMIN_DB_PASSWORD%
Environment=ADMIN_DB_NAME=%ADMIN_DB_NAME%

# the image's entrypoint runs the command as it is: keep-major.sh first, then the image's start
Exec=sh /ffs-db/keep-major.sh docker-entrypoint.sh postgres

# the exec form, as the accounts' units (Podman 5 trims the double quotes at both ends of a value)
HealthCmd=["pg_isready", "-U", "%SYNC_POSTGRES_USER%", "-d", "%SYNC_POSTGRES_NAME%"]
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
