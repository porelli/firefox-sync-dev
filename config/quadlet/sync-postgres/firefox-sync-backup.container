# Backups of the PostgreSQL database (docs/backups.md#the-backup-service): started by
# firefox-sync-backup.timer, off until you enable it:
#   systemctl --user enable --now firefox-sync-backup.timer
# One now: systemctl --user start firefox-sync-backup.service
[Unit]
Description=Firefox Sync - Backup of the databases
After=firefox-sync-network.service firefox-sync-postgres-db.service

[Container]
# SYNC_POSTGRES_IMAGE of .env: pg_dump of the server's major (with your own server: at least its major)
Image=%SYNC_POSTGRES_IMAGE%
ContainerName=firefox-sync-backup
Network=firefox-sync-network.network
Volume=firefox-sync-backups.volume:/backups
Volume=%SCRIPT_DIR%/config/backup:/ffs-backup:ro,z
Environment="BACKUP_SCOPE=sync"
Environment="BACKUP_KEEP=%BACKUP_KEEP%"
Environment="TOKENSERVER_DB_TYPE=postgres"
Environment="TOKENSERVER_DB_HOST=%SYNC_POSTGRES_HOST%"
Environment="TOKENSERVER_DB_PORT=%SYNC_POSTGRES_PORT%"
Environment="TOKENSERVER_DB_NAME=%SYNC_POSTGRES_NAME%"
# as the Sync server's own role, the owner of every table (docs/backups.md#restore-with-quadlets
# loads the dump as it too); without SYNC_POSTGRES_APP_USER SYNC_POSTGRES_USER
Environment="TOKENSERVER_DB_USER=%SYNC_POSTGRES_CONNECT_USER%"
Environment="TOKENSERVER_DB_PASSWORD=%SYNC_POSTGRES_CONNECT_PASSWORD%"
# the admin UI's database: dumped too, and where the runs are recorded
Environment="ADMIN_DB_USER=%ADMIN_DB_USER%"
Environment="ADMIN_DB_PASSWORD=%ADMIN_DB_PASSWORD%"
Environment="ADMIN_DB_NAME=%ADMIN_DB_NAME%"
Exec=sh /ffs-backup/backup.sh now

[Service]
Type=oneshot
